<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="header">
        <item name="android:textSize">@dimen/text_size_enlarged_1</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">#1D1B20</item>
    </style>

    <style name="subhead">
        <item name="android:textSize">@dimen/text_size_enlarged_0</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">#1D1B20</item>
    </style>

    <style name="title">
        <item name="android:textSize">@dimen/text_size_enlarged_1</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textColor">#1D1B20</item>
    </style>

    <style name="select_date">
        <item name="android:textSize">@dimen/text_size_enlarged_0</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">#49454F</item>
    </style>

    <style name="enter_period_caption">
        <item name="android:textSize">@dimen/text_size_enlarged_4</item>
        <item name="android:textColor">#1D1B20</item>
    </style>

    <style name="input_text">
        <item name="android:textSize">@dimen/text_size_enlarged_1</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textColor">#1D1B20</item>
    </style>

    <!-- Buttons -->

    <style name="Widget.AppTheme.LikeButton" parent="Widget.MaterialComponents.Button.TextButton.Icon">
        <item name="icon">@drawable/icset_like_24</item>
        <item name="iconTint">@color/likes_checkbox_tint</item>
        <item name="android:minWidth">0dp</item> <!-- Переопределение атрибута родительского стиля -->
        <item name="android:minHeight">@dimen/icon_size_min</item>

    </style>

    <style name="Widget.AppTheme.PersonButton" parent="Widget.MaterialComponents.Button.TextButton.Icon">
        <item name="icon">@drawable/icset_people_outline_24</item>
        <item name="iconTint">@color/people_checkbox_tint</item>
        <item name="android:minWidth">0dp</item> <!-- Переопределение атрибута родительского стиля -->
        <item name="android:minHeight">@dimen/icon_size_min</item>

    </style>

    <style name="Widget.AppTheme.UnspecifiedButton" parent="Widget.MaterialComponents.Button.TextButton.Icon">
        <item name="iconTint">?attr/colorControlNormal</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:minWidth">0dp</item> <!-- Переопределение атрибута родительского стиля -->
        <item name="android:minHeight">@dimen/icon_size_min</item>
    </style>


</resources>


